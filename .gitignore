# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
.next/
/out/
frontend/out/
dist

# production
/build
sitemap*.xml
robots.txt

# misc
.DS_Store
*.pem
plans/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
gh/gcp-service-account.json
gh/github-token.env
gh/*.db-shm
gh/*.db-wal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# server
token.env

# npm/pnpm scratch created by running the backend locally
backend/.cache/

# generated files
frontend/helpers/blog.json
# Ever fork: upstream ignores all of gh/data/ because it is BigQuery pipeline output.
# We generate it instead from ever/seed-gh-data.mjs over our own allowlisted repos and
# COMMIT the four JSON files, so the image builds without needing the pipeline.
# Everything else in gh/data/ (sqlite, archives, intermediates) stays ignored.
gh/data/*
!gh/data/*.json

# gh event pipeline
gh/event.db
gh/archive-data/
